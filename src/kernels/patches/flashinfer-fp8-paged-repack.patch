+template <typename KTraits, uint32_t HEAD_DIM>
+__device__ __forceinline__ void repack_fp8_tile_to_bf16(typename KTraits::DTypeKV* smem_fp8,
+                                                        typename KTraits::DTypeQ* smem_bf16,
+                                                        uint32_t thread_id) {
+  using DTypeKV = typename KTraits::DTypeKV;
+  using DTypeQ = typename KTraits::DTypeQ;
+  constexpr SwizzleMode SWIZZLE = KTraits::SWIZZLE_MODE_KV;
+  constexpr uint32_t FP8_COLS = HEAD_DIM / upcast_size<DTypeKV>();
+  constexpr uint32_t BF16_COLS = HEAD_DIM / upcast_size<DTypeQ>();
+  constexpr uint32_t NUM_B128 = KTraits::CTA_TILE_KV * FP8_COLS;
+
+  b128_t* src = reinterpret_cast<b128_t*>(smem_fp8);
+  b128_t* dst = reinterpret_cast<b128_t*>(smem_bf16);
+#pragma unroll
+  for (uint32_t idx = thread_id; idx < NUM_B128; idx += KTraits::NUM_THREADS) {
+    const uint32_t row = idx / FP8_COLS, col = idx % FP8_COLS;
+    b128_t packed = src[get_permuted_offset<SWIZZLE, FP8_COLS>(row, col)];
+    alignas(16) DTypeQ converted[16];
+    vec_cast<DTypeQ, DTypeKV>::template cast<16>(converted,
+                                                 reinterpret_cast<DTypeKV*>(&packed));
+    dst[get_permuted_offset<SWIZZLE, BF16_COLS>(row, 2 * col)] =
+        *reinterpret_cast<b128_t*>(&converted[0]);
+    dst[get_permuted_offset<SWIZZLE, BF16_COLS>(row, 2 * col + 1)] =
+        *reinterpret_cast<b128_t*>(&converted[8]);
+  }
+}
